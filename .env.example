# =====================================================
# LEGACY WHOLESALE CRM
# Example Environment Configuration
#
# COPY THIS FILE TO:
# .env
#
# NEVER COMMIT YOUR REAL .env FILE.
# =====================================================

PORT=8787


# -----------------------------------------------------
# TWILIO
# -----------------------------------------------------

TWILIO_ACCOUNT_SID=

TWILIO_AUTH_TOKEN=

TWILIO_PHONE_NUMBER=

TWILIO_VOICE_NUMBER=

TWILIO_MESSAGING_SERVICE_SID=


# -----------------------------------------------------
# CALLING
# -----------------------------------------------------

VOICE_ENABLED=false

CALL_AGENT_NUMBER=

CALL_BRAND_NAME=Legacy Wholesale CRM

CALL_BRAND_EMAIL=

CALL_BRAND_LOGO_URL=


# -----------------------------------------------------
# SMS
# -----------------------------------------------------

SMS_ENABLED=false


# -----------------------------------------------------
# RCS
# -----------------------------------------------------

RCS_ENABLED=false

TWILIO_RCS_MESSAGING_SERVICE_SID=

RCS_BRAND_NAME=

RCS_LOGO_URL=

RCS_DESCRIPTION=

RCS_PRIVACY_URL=

RCS_TERMS_URL=


# -----------------------------------------------------
# EMAIL - FUTURE PHASE
# -----------------------------------------------------

EMAIL_ENABLED=false

SMTP_HOST=

SMTP_PORT=587

SMTP_SECURE=false

SMTP_USER=

SMTP_PASS=

EMAIL_FROM=

EMAIL_REPLY_TO=


# -----------------------------------------------------
# DATABASE - FUTURE PHASE
# -----------------------------------------------------

DATABASE_URL=


# -----------------------------------------------------
# AI - FUTURE PHASE
# -----------------------------------------------------

OPENAI_API_KEY=


# -----------------------------------------------------
# GOOGLE CALENDAR - FUTURE PHASE
# -----------------------------------------------------

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

GOOGLE_REDIRECT_URI=


# ======================================================
# AI SELLER QUALIFICATION
# ======================================================

# Background qualification is OFF by default.
AI_QUALIFICATION_AUTO_ENABLED=false

# APPROVAL REQUIRED is the recommended initial mode.
# Options:
# RECOMMEND ONLY
# APPROVAL REQUIRED
# AUTOMATIC
AI_QUALIFICATION_MODE=APPROVAL REQUIRED

# Background sweep every 5 minutes.
AI_QUALIFICATION_INTERVAL_MS=300000

# Re-analyze after this many minutes without an AI review.
AI_QUALIFICATION_STALE_MINUTES=120

TWILIO_API_KEY_SID=

TWILIO_API_KEY_SECRET=



# ======================================================
# PRODUCTION / HOSTING
# ======================================================

HOST=0.0.0.0

PUBLIC_BASE_URL=

CRM_DATA_DIR=


# ======================================================
# TWILIO WEBHOOK SECURITY
# ======================================================

TWILIO_VALIDATE_WEBHOOKS=true


# ======================================================
# AI CALL / TEXT CENTER
# ======================================================

AI_CALLING_ENABLED=true

AI_CALL_TEXT_ENABLED=true

AI_CALL_TEXT_PHASE=

OPENAI_CALL_MODEL=gpt-5.6

AI_VOICE_WS_URL=